{
  "$schema": "./schema/security-route-manifest.schema.json",
  "version": "1.0.0",
  "routes": [
    {
      "method": "GET",
      "path": "/.well-known/openid-configuration",
      "surface": "public_discovery",
      "auth_required": "none",
      "gateway_required": false,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "public",
      "description": "OpenID Connect discovery metadata providing issuer endpoints and supported capabilities."
    },
    {
      "method": "GET",
      "path": "/.well-known/jwks.json",
      "surface": "public_discovery",
      "auth_required": "none",
      "gateway_required": false,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "public",
      "description": "JSON Web Key Set containing active RS256 public keys for offline consumer token verification."
    },
    {
      "method": "GET",
      "path": "/.well-known/jwks",
      "surface": "public_discovery",
      "auth_required": "none",
      "gateway_required": false,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "public",
      "description": "Standard alias for JWKS public key distribution."
    },
    {
      "method": "GET",
      "path": "/api/auth/jwks",
      "surface": "public_discovery",
      "auth_required": "none",
      "gateway_required": false,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "public",
      "description": "Internal handler endpoint serving JWKS public keys."
    },
    {
      "method": "GET",
      "path": "/api/auth/oauth2/authorize",
      "surface": "public_oauth",
      "auth_required": "none_or_browser_session",
      "gateway_required": false,
      "csrf_protected": false,
      "rate_limited": true,
      "privilege_scope": "public",
      "description": "OAuth 2.1 authorization endpoint. Validates client_id, redirect_uri, PKCE S256 code_challenge, and state."
    },
    {
      "method": "POST",
      "path": "/api/auth/oauth2/token",
      "surface": "public_oauth",
      "auth_required": "client_credentials_or_pkce",
      "gateway_required": false,
      "csrf_protected": false,
      "rate_limited": true,
      "privilege_scope": "public",
      "description": "Token exchange and refresh endpoint. Supports authorization_code and refresh_token grants with strict CAS rotation."
    },
    {
      "method": "GET",
      "path": "/api/auth/oauth2/userinfo",
      "surface": "public_oauth",
      "auth_required": "bearer_jwt",
      "gateway_required": false,
      "csrf_protected": false,
      "rate_limited": true,
      "privilege_scope": "public",
      "description": "OIDC UserInfo endpoint returning verified claims for authenticated subject."
    },
    {
      "method": "POST",
      "path": "/api/auth/oauth2/revoke",
      "surface": "public_oauth",
      "auth_required": "client_or_bearer",
      "gateway_required": false,
      "csrf_protected": false,
      "rate_limited": true,
      "privilege_scope": "public",
      "description": "RFC 7009 token revocation endpoint for access and refresh tokens."
    },
    {
      "method": "POST",
      "path": "/api/auth/oauth2/introspect",
      "surface": "public_oauth",
      "auth_required": "client_credentials",
      "gateway_required": false,
      "csrf_protected": false,
      "rate_limited": true,
      "privilege_scope": "confidential_client",
      "description": "RFC 7662 token introspection endpoint."
    },
    {
      "method": "POST",
      "path": "/api/auth/oauth2/register",
      "surface": "blocked_internal",
      "auth_required": "blocked",
      "gateway_required": false,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "none",
      "description": "Dynamic client registration disabled. Returns HTTP 403 Forbidden to all callers."
    },
    {
      "method": "POST",
      "path": "/api/auth/oauth2/create-client",
      "surface": "blocked_internal",
      "auth_required": "blocked",
      "gateway_required": false,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "none",
      "description": "Unprotected client creation disabled. Returns HTTP 403 Forbidden to all callers."
    },
    {
      "method": "POST",
      "path": "/api/auth/oauth2/update-client",
      "surface": "blocked_internal",
      "auth_required": "blocked",
      "gateway_required": false,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "none",
      "description": "Unprotected client update disabled. Returns HTTP 403 Forbidden to all callers."
    },
    {
      "method": "POST",
      "path": "/api/auth/oauth2/delete-client",
      "surface": "blocked_internal",
      "auth_required": "blocked",
      "gateway_required": false,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "none",
      "description": "Unprotected client deletion disabled. Returns HTTP 403 Forbidden to all callers."
    },
    {
      "method": "POST",
      "path": "/api/auth/oauth2/client/rotate-secret",
      "surface": "blocked_internal",
      "auth_required": "blocked",
      "gateway_required": false,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "none",
      "description": "Direct client secret rotation disabled. Returns HTTP 403 Forbidden to all callers."
    },
    {
      "method": "POST",
      "path": "/api/auth/app-admin/login",
      "surface": "retired",
      "auth_required": "none",
      "gateway_required": false,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "none",
      "description": "Permanently retired legacy credential-relay authentication endpoint. Returns HTTP 410 Gone."
    },
    {
      "method": "POST",
      "path": "/api/auth/app-admin/verify",
      "surface": "retired",
      "auth_required": "none",
      "gateway_required": false,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "none",
      "description": "Permanently retired legacy token verification endpoint. Returns HTTP 410 Gone."
    },
    {
      "method": "POST",
      "path": "/api/auth/app-admin/logout",
      "surface": "retired",
      "auth_required": "none",
      "gateway_required": false,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "none",
      "description": "Permanently retired legacy logout endpoint. Returns HTTP 410 Gone."
    },
    {
      "method": "GET",
      "path": "/health",
      "surface": "health",
      "auth_required": "none",
      "gateway_required": false,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "public",
      "description": "Liveness health check endpoint."
    },
    {
      "method": "GET",
      "path": "/ready",
      "surface": "health",
      "auth_required": "none",
      "gateway_required": false,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "public",
      "description": "Readiness probe endpoint."
    },
    {
      "method": "GET",
      "path": "/",
      "surface": "health",
      "auth_required": "none",
      "gateway_required": false,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "public",
      "description": "Service root identifier endpoint."
    },
    {
      "method": "GET",
      "path": "/api/admin/clients",
      "surface": "platform_admin",
      "auth_required": "session_admin",
      "gateway_required": true,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "super_admin_or_scoped_admin",
      "description": "Lists OAuth clients. Super-admins see all applications; scoped admins see only their assigned application."
    },
    {
      "method": "POST",
      "path": "/api/admin/clients",
      "surface": "platform_admin",
      "auth_required": "session_admin",
      "gateway_required": true,
      "csrf_protected": true,
      "rate_limited": false,
      "privilege_scope": "super_admin_only",
      "description": "Creates a new OAuth application. Strictly restricted to Super-Admins."
    },
    {
      "method": "GET",
      "path": "/api/admin/clients/:id",
      "surface": "platform_admin",
      "auth_required": "session_admin",
      "gateway_required": true,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "scoped_to_target",
      "description": "Retrieves OAuth client configuration. Scoped admins restricted to assigned client."
    },
    {
      "method": "PATCH",
      "path": "/api/admin/clients/:id",
      "surface": "platform_admin",
      "auth_required": "session_admin",
      "gateway_required": true,
      "csrf_protected": true,
      "rate_limited": false,
      "privilege_scope": "scoped_to_target_or_super",
      "description": "Updates OAuth client configuration. Strips privilege fields for scoped admins."
    },
    {
      "method": "DELETE",
      "path": "/api/admin/clients/:id",
      "surface": "platform_admin",
      "auth_required": "session_admin",
      "gateway_required": true,
      "csrf_protected": true,
      "rate_limited": false,
      "privilege_scope": "super_admin_only",
      "description": "Deletes OAuth client and cascades associated tokens and app admins. Strictly restricted to Super-Admins."
    },
    {
      "method": "GET",
      "path": "/api/admin/clients/:clientId/users",
      "surface": "platform_admin",
      "auth_required": "session_admin",
      "gateway_required": true,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "scoped_to_target",
      "description": "Lists users registered for specified client."
    },
    {
      "method": "POST",
      "path": "/api/admin/clients/:clientId/users",
      "surface": "platform_admin",
      "auth_required": "session_admin",
      "gateway_required": true,
      "csrf_protected": true,
      "rate_limited": false,
      "privilege_scope": "scoped_to_target",
      "description": "Registers a user for the specified private application."
    },
    {
      "method": "DELETE",
      "path": "/api/admin/clients/:clientId/users/:userId",
      "surface": "platform_admin",
      "auth_required": "session_admin",
      "gateway_required": true,
      "csrf_protected": true,
      "rate_limited": false,
      "privilege_scope": "scoped_to_target",
      "description": "Removes a user's registration from the specified application."
    },
    {
      "method": "GET",
      "path": "/api/admin/clients/:clientId/app-admins",
      "surface": "platform_admin",
      "auth_required": "session_admin",
      "gateway_required": true,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "super_admin_only",
      "description": "Lists delegated application admins for specified client. Restricted to Super-Admins."
    },
    {
      "method": "POST",
      "path": "/api/admin/clients/:clientId/app-admins",
      "surface": "platform_admin",
      "auth_required": "session_admin",
      "gateway_required": true,
      "csrf_protected": true,
      "rate_limited": false,
      "privilege_scope": "super_admin_only",
      "description": "Provisions delegated app admin for specified client. Restricted to Super-Admins."
    },
    {
      "method": "PUT",
      "path": "/api/admin/clients/:clientId/app-admins/:adminId",
      "surface": "platform_admin",
      "auth_required": "session_admin",
      "gateway_required": true,
      "csrf_protected": true,
      "rate_limited": false,
      "privilege_scope": "super_admin_only",
      "description": "Updates delegated app admin status or credentials. Restricted to Super-Admins."
    },
    {
      "method": "PATCH",
      "path": "/api/admin/clients/:clientId/app-admins/:adminId",
      "surface": "platform_admin",
      "auth_required": "session_admin",
      "gateway_required": true,
      "csrf_protected": true,
      "rate_limited": false,
      "privilege_scope": "super_admin_only",
      "description": "Updates delegated app admin status or credentials (alias for PUT). Restricted to Super-Admins."
    },
    {
      "method": "DELETE",
      "path": "/api/admin/clients/:clientId/app-admins/:adminId",
      "surface": "platform_admin",
      "auth_required": "session_admin",
      "gateway_required": true,
      "csrf_protected": true,
      "rate_limited": false,
      "privilege_scope": "super_admin_only",
      "description": "Revokes delegated app admin. Restricted to Super-Admins."
    },
    {
      "method": "GET",
      "path": "/api/admin/app/:clientId/config",
      "surface": "platform_admin",
      "auth_required": "session_admin",
      "gateway_required": true,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "scoped_to_target_or_super",
      "description": "Retrieves client configuration via app prefix."
    },
    {
      "method": "PATCH",
      "path": "/api/admin/app/:clientId/config",
      "surface": "platform_admin",
      "auth_required": "session_admin",
      "gateway_required": true,
      "csrf_protected": true,
      "rate_limited": false,
      "privilege_scope": "scoped_to_target_or_super",
      "description": "Updates client configuration via app prefix. Strips privilege fields for scoped admins."
    },
    {
      "method": "GET",
      "path": "/api/admin/stats",
      "surface": "platform_admin",
      "auth_required": "session_admin",
      "gateway_required": true,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "super_admin_only",
      "description": "Global tenant statistics. Strictly restricted to Super-Admins."
    },
    {
      "method": "GET",
      "path": "/api/admin/logs",
      "surface": "platform_admin",
      "auth_required": "session_admin",
      "gateway_required": true,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "super_admin_only",
      "description": "Platform audit event logs. Strictly restricted to Super-Admins."
    },
    {
      "method": "GET",
      "path": "/api/admin/users",
      "surface": "platform_admin",
      "auth_required": "session_admin",
      "gateway_required": true,
      "csrf_protected": false,
      "rate_limited": false,
      "privilege_scope": "super_admin_only",
      "description": "Global user accounts list. Strictly restricted to Super-Admins."
    },
    {
      "method": "POST",
      "path": "/api/admin/users",
      "surface": "platform_admin",
      "auth_required": "session_admin",
      "gateway_required": true,
      "csrf_protected": true,
      "rate_limited": true,
      "privilege_scope": "super_admin_only",
      "description": "Provisions new platform administrator account. Strictly restricted to Super-Admins."
    }
  ]
}
