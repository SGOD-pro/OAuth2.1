{
  "name": "hono",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && esbuild --bundle --outfile=./dist/index.cjs --platform=node --target=node24 --format=cjs ./src/lambda.ts",
    "build:node": "esbuild --bundle --outfile=./dist/index.cjs --platform=node --target=node24 --format=cjs ./src/node-server.ts",
    "start": "node dist/index.cjs",
    "build:vercel": "esbuild --bundle --outfile=./dist/index.cjs --platform=node --target=node24 --format=cjs ./src/vercel.ts",
    "build:netlify": "esbuild --bundle --outfile=./dist/index.cjs --platform=node --target=node24 --format=cjs ./src/netlify.ts",
    "db:setup": "tsx --env-file=.env scripts/db-setup.ts",
    "db:seed": "tsx --env-file=.env scripts/db-seed.ts",
    "zip": "zip -j lambda.zip dist/index.cjs",
    "update": "aws lambda update-function-code --zip-file fileb://lambda.zip --function-name hello --region us-east-1",
    "publish": "aws lambda publish-version --function-name hello --region us-east-1",
    "deploy": "run-s build zip update publish",
    "dev": "tsx watch --env-file=.env src/dev.ts",
    "security:self-check": "tsx --env-file=.env scripts/security-self-check.ts",
    "test:security": "tsx tests/security/test-app-admin-security.ts",
    "test:gate": "tsx tests/security/phase25-security-gate.ts",
    "test:second-pass": "tsx tests/security/second-pass-security-suite.ts",
    "test:security-gate": "tsx tests/security/final-adversarial-gate.ts",
    "test:prod-config": "tsx tests/security/test-production-config.ts",
    "test:oidc-interop": "tsx tests/security/e2e-oidc-interop.test.ts",
    "test:load": "tsx tests/security/load-and-performance.test.ts",
    "test:direct-backend": "tsx tests/security/direct-backend-access-suite.ts",
    "test:session-hijack": "tsx tests/security/session-hijacking-suite.ts",
    "test:oauth-tx": "tsx tests/security/oauth-transaction-suite.ts",
    "test:credential-comp": "tsx tests/security/credential-compromise-suite.ts",
    "test:cross-tenant": "tsx tests/security/cross-tenant-matrix.ts",
    "test:prod-vs-dev": "tsx tests/security/production-vs-development-suite.ts",
    "test:deployed-consumer": "tsx tests/security/deployed-consumer-suite.ts",
    "test:aws-dashboard": "tsx tests/security/aws-dashboard-integration-suite.ts",
    "test:full-adversarial": "tsx tests/security/full-production-adversarial-suite.ts",
    "test:all-security": "tsx tests/security/full-production-adversarial-suite.ts && tsx tests/security/final-adversarial-gate.ts && tsx tests/security/direct-backend-access-suite.ts && tsx tests/security/session-hijacking-suite.ts && tsx tests/security/oauth-transaction-suite.ts && tsx tests/security/credential-compromise-suite.ts && tsx tests/security/cross-tenant-matrix.ts && tsx tests/security/production-vs-development-suite.ts && tsx tests/security/deployed-consumer-suite.ts && tsx tests/security/aws-dashboard-integration-suite.ts",
    "admin:create": "tsx --env-file=.env scripts/create-admin.ts"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "esbuild": "^0.21.4",
    "npm-run-all2": "^6.2.0",
    "tsx": "^4.19.2"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.6.10",
    "@better-auth/oauth-provider": "^1.6.10",
    "@hono/node-server": "^2.0.2",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.38.2",
    "better-auth": "^1.6.25",
    "dotenv": "^17.4.2",
    "hono": "^4.12.18",
    "mongodb": "^7.2.0",
    "zod": "^4.4.3"
  }
}
