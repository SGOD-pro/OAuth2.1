NODE_ENV=development
PORT=3000

MONGO_URI=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FRONTEND_URL=
TRUSTED_PROXY_CIDRS=

AUTH_PUBLIC_SIGNUP_ENABLED=true
AUTH_EMAIL_VERIFICATION_ENABLED=false

# Optional: dedicated signing key for app-admin JWTs (min 32 chars).
# If not set, a sub-key is automatically derived from BETTER_AUTH_SECRET via HMAC-SHA256,
# ensuring app-admin tokens are never signed with the raw Better Auth master secret.
APP_ADMIN_JWT_SECRET=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
