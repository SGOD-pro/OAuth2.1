NODE_ENV=development
PORT=3000

MONGO_URI=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FRONTEND_URL=
TRUSTED_PROXY_CIDRS=

AUTH_PUBLIC_SIGNUP_ENABLED=true
AUTH_EMAIL_VERIFICATION_ENABLED=false

# Dedicated signing key for app-admin JWTs (≥32 chars).
# REQUIRED in production. In development/test, a sub-key is derived from BETTER_AUTH_SECRET.
APP_ADMIN_JWT_SECRET=your_app_admin_jwt_secret_min_32_characters_here

# Dedicated AES-256-GCM encryption key for app-admin TOTP secrets at rest (≥32 chars).
# REQUIRED in production. In development/test, a key is derived from APP_ADMIN_JWT_SECRET.
APP_ADMIN_TOTP_KEY=your_app_admin_totp_encryption_key_min_32_characters_here

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
