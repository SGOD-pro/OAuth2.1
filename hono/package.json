{
  "name": "hono",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && esbuild --bundle --outfile=./dist/index.cjs --platform=node --target=node20 --format=cjs ./src/lambda.ts",
    "build:node": "esbuild --bundle --outfile=./dist/index.js --platform=node --target=node20 --format=cjs ./src/node-server.ts",
    "build:vercel": "esbuild --bundle --outfile=./dist/index.js --platform=node --target=node20 --format=cjs ./src/vercel.ts",
    "build:netlify": "esbuild --bundle --outfile=./dist/index.js --platform=node --target=node20 --format=cjs ./src/netlify.ts",
    "db:setup": "tsx --env-file=.env scripts/db-setup.ts",
    "zip": "zip -j lambda.zip dist/index.js",
    "update": "aws lambda update-function-code --zip-file fileb://lambda.zip --function-name hello --region us-east-1",
    "publish": "aws lambda publish-version --function-name hello --region us-east-1",
    "deploy": "run-s build zip update publish",
    "dev": "tsx watch --env-file=.env src/dev.ts",
    "security:self-check": "tsx --env-file=.env scripts/security-self-check.ts",
    "admin:create": "tsx --env-file=.env scripts/create-admin.ts"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "esbuild": "^0.21.4",
    "npm-run-all2": "^6.2.0",
    "tsx": "^4.19.2"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.6.10",
    "@better-auth/oauth-provider": "^1.6.10",
    "@hono/node-server": "^2.0.2",
    "better-auth": "^1.6.25",
    "dotenv": "^17.4.2",
    "hono": "^4.12.18",
    "mongodb": "^7.2.0",
    "zod": "^4.4.3"
  }
}
